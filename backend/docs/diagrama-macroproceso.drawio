        <mxCell id="a4" value="&lt;b&gt;Bitácora de actividades&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Registro de cada acción, cambio de estado e ingreso (CU-12)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
