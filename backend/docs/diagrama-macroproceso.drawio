        <mxCell id="nota" value="Ciudadano y usuarios internos según RN01: Auxiliar, Técnico, Supervisor, Jefe de Departamento y Administrador." style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1">
