<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.0">
  <diagram id="macroproceso" name="Mapa de macroprocesos">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Mapa de macroprocesos — Sistema de Quejas, Reclamos, Denuncias y Sugerencias · Municipalidad de Granados, B.V." style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1400" height="34" as="geometry" />
        </mxCell>

        <!-- Entrada / salida -->
        <mxCell id="in" value="&lt;b&gt;ENTRADA&lt;/b&gt;&lt;hr&gt;Ciudadano registrado en la base de ciudadanos con una necesidad:&lt;br&gt;&lt;br&gt;• Queja&lt;br&gt;• Reclamo&lt;br&gt;• Denuncia&lt;br&gt;• Sugerencia&lt;br&gt;&lt;br&gt;+ evidencia (opcional)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="170" height="300" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;SALIDA&lt;/b&gt;&lt;hr&gt;Ciudadano satisfecho / informado:&lt;br&gt;&lt;br&gt;• Caso &lt;i&gt;Resuelto&lt;/i&gt; con oficio de resolución firmado&lt;br&gt;• o caso &lt;i&gt;Rechazado&lt;/i&gt; con motivo&lt;br&gt;&lt;br&gt;Notificado por correo y consultable con su código de seguimiento" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1530" y="270" width="170" height="300" as="geometry" />
        </mxCell>

        <!-- PROCESOS ESTRATÉGICOS -->
        <mxCell id="bandE" value="PROCESOS ESTRATÉGICOS" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="60" width="1300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;Dirección municipal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Misión y visión: servicios de calidad, transparencia y participación ciudadana&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Reportería y estadísticas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Reportes PDF / Excel de casos por estado, tipo, departamento y periodo para la toma de decisiones (CU-13)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="670" y="100" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;Control y mejora continua&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Reglas de negocio (RN), auditoría por bitácora y revisión de notificaciones fallidas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="380" height="100" as="geometry" />
        </mxCell>

        <!-- PROCESOS OPERATIVOS (CLAVE) -->
        <mxCell id="bandO" value="PROCESOS OPERATIVOS — GESTIÓN DEL CASO" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="210" y="250" width="1300" height="340" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1. Recepción y registro&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CU-02&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="225" y="320" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Revisión inicial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CU-04 · CU-14&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="320" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Atención del caso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CU-05&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="735" y="320" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Supervisión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CU-06&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="990" y="320" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Resolución y cierre&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CU-07&lt;/span&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=22;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1245" y="320" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- Detalle de cada macroproceso -->
        <mxCell id="d1" value="&lt;b&gt;Ciudadano&lt;/b&gt;&lt;br&gt;Verificación por DPI + código; registra el caso y obtiene código de seguimiento.&lt;br&gt;&lt;i&gt;Sale:&lt;/i&gt; caso Registrado" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="418" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Auxiliar&lt;/b&gt;&lt;br&gt;Acepta y asigna Técnico, rechaza (aprueba el Supervisor) o pide ampliación al ciudadano.&lt;br&gt;&lt;i&gt;Sale:&lt;/i&gt; informe de revisión inicial" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="485" y="418" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Técnico&lt;/b&gt;&lt;br&gt;Trabajo de campo, registra actividades y finaliza con soporte.&lt;br&gt;&lt;i&gt;Sale:&lt;/i&gt; informe de atención" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="418" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;Aprueba el reporte o lo devuelve al Técnico; aprueba o revierte rechazos.&lt;br&gt;&lt;i&gt;Sale:&lt;/i&gt; informe de supervisión" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="995" y="418" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;Jefe de Departamento&lt;/b&gt;&lt;br&gt;Firma el oficio o devuelve a Supervisión.&lt;br&gt;&lt;i&gt;Sale:&lt;/i&gt; oficio de resolución, caso Resuelto" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1250" y="418" width="235" height="80" as="geometry" />
        </mxCell>

        <mxCell id="trans" value="&lt;b&gt;Seguimiento y comunicación con el ciudadano&lt;/b&gt; — consulta de estado con código de seguimiento (CU-03) · notificaciones por correo en registro, ampliación, rechazo y resolución (CU-08)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="520" width="1260" height="50" as="geometry" />
        </mxCell>

        <!-- Flujo principal -->
        <mxCell id="f0" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;" edge="1" parent="1" source="in" target="p1">
