        <!-- Retroalimentaciones -->
        <mxCell id="r1" value="devolución al Técnico" style="endArrow=open;endSize=8;html=1;dashed=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.4;exitY=0;entryX=0.6;entryY=0;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="p4" target="p3">
