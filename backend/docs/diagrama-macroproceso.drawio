        <!-- PROCESOS DE APOYO -->
        <mxCell id="bandA" value="PROCESOS DE APOYO" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="610" width="1300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Gestión de usuarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Altas, edición, estados y reasignación de casos (CU-09)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="230" y="650" width="235" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Administración de catálogos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Departamentos, categorías y motivos de rechazo (CU-10)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="485" y="650" width="235" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Seguridad y acceso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Ingreso con JWT, bloqueo por intentos, recuperación de contraseña y cuenta propia (CU-01, CU-11)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="740" y="650" width="235" height="100" as="geometry" />
