  <diagram id="estados-caso" name="Estados del Caso">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Diagrama de estados — Caso (queja, reclamo, sugerencia o denuncia)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="34" as="geometry" />
        </mxCell>

        <!-- Pseudoestados -->
        <mxCell id="ini" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fin1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1680" y="140" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fin2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="215" y="780" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Estados (flujo principal) -->
        <mxCell id="reg" value="&lt;b&gt;Registrado&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="&lt;b&gt;En Revisión&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ate" value="&lt;b&gt;En Atención&lt;/b&gt;&lt;hr&gt;&lt;span style=&quot;font-size:10px&quot;&gt;do / Técnico registra actividades&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sup" value="&lt;b&gt;En Supervisión&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fir" value="&lt;b&gt;Pendiente de Firma&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="res" value="&lt;b&gt;Resuelto&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="120" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Estados (rechazo / ampliación) -->
        <mxCell id="par" value="&lt;b&gt;Pendiente de Aprobación de Rechazo&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="420" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="amp" value="&lt;b&gt;Requiere Ampliación&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;Rechazado&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="640" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Transiciones flujo principal -->
        <mxCell id="e1" value="Ciudadano registra caso&lt;br&gt;/ genera código y notifica" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ini" target="reg">
          <mxGeometry x="-0.2" y="40" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Auxiliar acepta caso" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reg" target="rev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Auxiliar asigna Técnico&lt;br&gt;[técnico disponible]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rev" target="ate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Técnico finaliza atención&lt;br&gt;[reporte completo]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ate" target="sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Supervisor aprueba&lt;br&gt;reporte" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sup" target="fir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Jefatura firma oficio&lt;br&gt;/ notifica resolución" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fir" target="res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=open;endSize=10;html=1;" edge="1" parent="1" source="res" target="fin1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Devoluciones -->
        <mxCell id="e8" value="Supervisor devuelve al Técnico&lt;br&gt;/ observaciones" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="sup" target="ate">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="80" />
              <mxPoint x="750" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="Jefatura devuelve a Supervisión&lt;br&gt;/ observaciones" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="fir" target="sup">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="250" />
              <mxPoint x="1010" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Rechazo y ampliación -->
        <mxCell id="e10" value="Auxiliar rechaza&lt;br&gt;[sin ampliación]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reg" target="par">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Auxiliar rechaza [con ampliación]&lt;br&gt;/ notifica al ciudadano" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.75;entryX=0;entryY=0.3;" edge="1" parent="1" source="reg" target="amp">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="173" />
              <mxPoint x="350" y="441" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="Supervisor aprueba rechazo&lt;br&gt;[motivo = Información incompleta]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="par" target="amp">
          <mxGeometry x="0.1" y="-30" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e13" value="Supervisor aprueba rechazo&lt;br&gt;[otro motivo] / notifica" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="par" target="rec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="Supervisor regresa a revisión&lt;br&gt;/ observaciones" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="par" target="rev">
          <mxGeometry x="-0.75" y="-10" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="455" />
              <mxPoint x="40" y="60" />
              <mxPoint x="490" y="60" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="Ciudadano reenvía&lt;br&gt;con información ampliada" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="amp" target="rev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=open;endSize=10;html=1;" edge="1" parent="1" source="rec" target="fin2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nota -->
        <mxCell id="nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Cada transición queda registrada en &lt;i&gt;bitacora_cambio&lt;/i&gt; (estado anterior → nuevo).&lt;br&gt;• Si un Técnico deja de estar Activo, el Admin traslada sus casos a otro Técnico; el caso conserva su estado (RN35).&lt;br&gt;• El rechazo solo es posible desde &lt;i&gt;Registrado&lt;/i&gt;.&lt;br&gt;• Estados finales: &lt;i&gt;Resuelto&lt;/i&gt; y &lt;i&gt;Rechazado&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=16;fontSize=11;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="520" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="estados-usuario" name="Estados del Usuario">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Diagrama de estados — Cuenta de Usuario interno" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="700" height="34" as="geometry" />
        </mxCell>

        <mxCell id="ini" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="295" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="act" value="&lt;b&gt;Activo&lt;/b&gt;&lt;hr&gt;&lt;span style=&quot;font-size:10px&quot;&gt;puede iniciar sesión&lt;br&gt;login exitoso / reinicia intentos fallidos&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="265" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="blo" value="&lt;b&gt;Bloqueado&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ina" value="&lt;b&gt;Inactivo&lt;/b&gt;&lt;hr&gt;&lt;span style=&quot;font-size:10px&quot;&gt;no puede recuperar contraseña&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="900" y="275" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aus" value="&lt;b&gt;Ausente&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="470" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="Admin crea usuario&lt;br&gt;/ estado indicado en el formulario" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ini" target="act">
          <mxGeometry x="-0.1" y="25" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="u2" value="5 intentos fallidos de login" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0;entryY=0.3;" edge="1" parent="1" source="act" target="blo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="Admin activa&lt;br&gt;/ reinicia intentos fallidos" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.1;" edge="1" parent="1" source="blo" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="u4" value="Admin inactiva&lt;br&gt;[sin casos activos o casos reasignados]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="act" target="ina">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="Admin activa / reinicia intentos" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;entryX=1;entryY=0.6;" edge="1" parent="1" source="ina" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="u6" value="Admin marca ausente&lt;br&gt;[sin casos activos o casos reasignados]" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="act" target="aus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="Admin activa&lt;br&gt;/ reinicia intentos fallidos" style="endArrow=open;endSize=10;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=0.95;entryY=1;" edge="1" parent="1" source="aus" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="notaU" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• El Admin puede cambiar a cualquier estado desde cualquier estado (CU-10); aquí se muestran las transiciones principales.&lt;br&gt;• Al salir de Activo, si el usuario es Técnico con casos En Atención, En Supervisión, Pendiente de Firma o Requiere Ampliación, el Admin debe elegir otro Técnico activo del departamento; si no existe, el cambio se rechaza (FA08 / FA10).&lt;br&gt;• Solo un usuario Activo puede autenticarse." style="shape=note;whiteSpace=wrap;html=1;size=16;fontSize=11;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="560" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
